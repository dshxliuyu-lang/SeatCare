.intro{padding:26rpx 8rpx 38rpx}.green{color:#176b4d;font-size:25rpx;font-weight:700}.intro-title{font-size:44rpx;line-height:1.4;font-weight:800;margin-top:14rpx}.tabs{display:flex;padding:8rpx;background:#e4ece8;border-radius:14rpx;margin-bottom:24rpx}.tab{flex:1;height:70rpx;line-height:70rpx;text-align:center;color:#617068}.active{background:#fff;color:#176b4d;border-radius:10rpx;font-weight:700}.symbol{width:70rpx;height:70rpx;line-height:70rpx;text-align:center;background:#dceee5;color:#176b4d;border-radius:12rpx;margin-bottom:26rpx}.title{font-size:36rpx;font-weight:700}.lead{display:block;color:#617068;line-height:1.7;margin:16rpx 0 28rpx}.point{display:flex;gap:16rpx;line-height:1.6;margin:18rpx 0}.check{color:#176b4d;font-weight:800}.note{padding:24rpx;background:#edf6f1;border-radius:12rpx;font-size:26rpx;line-height:1.6;margin-top:28rpx}.note-title,.boundary-title{display:block;font-weight:700;margin-bottom:6rpx}.note-title{color:#176b4d}.boundary{padding:28rpx;background:#fff7e7;color:#715c3d;border-radius:14rpx;font-size:25rpx;line-height:1.65;margin:26rpx 0}