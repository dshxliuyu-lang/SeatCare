.shoot-page{height:100vh;display:flex;flex-direction:column;background:#0d1b16;box-sizing:border-box}
.shoot-header{padding:30rpx 32rpx 20rpx}
.step-title{display:block;color:#fff;font-size:36rpx;font-weight:800}
.step-sub{display:block;margin-top:8rpx;color:rgba(255,255,255,.65);font-size:24rpx}
.guide-area{position:relative;flex:1;margin:0 32rpx;border-radius:20rpx;overflow:hidden;background:#0a1512}
.guide-hint{position:absolute;bottom:24rpx;left:50%;transform:translateX(-50%);color:rgba(255,255,255,.55);font-size:22rpx;white-space:nowrap}
.silhouette{position:absolute;top:10%;left:50%;transform:translateX(-50%);width:52%;height:80%;pointer-events:none}
.sil-head{position:absolute;top:2%;left:50%;transform:translateX(-50%);width:130rpx;height:130rpx;border:3rpx dashed rgba(255,255,255,.6);border-radius:50%}
.sil-body{position:absolute;top:22%;left:50%;transform:translateX(-50%);width:86%;height:76%;border:3rpx dashed rgba(255,255,255,.6);border-radius:50rpx 50rpx 24rpx 24rpx}
.tilt-warn{position:absolute;top:24rpx;left:50%;transform:translateX(-50%);padding:12rpx 28rpx;background:rgba(226,74,55,.94);color:#fff;border-radius:999rpx;font-size:24rpx;font-weight:700;white-space:nowrap}
.step-chip{position:absolute;right:20rpx;bottom:20rpx;padding:8rpx 20rpx;color:#fff;background:rgba(0,0,0,.5);border-radius:999rpx;font-size:22rpx}
.shoot-tips{padding:24rpx 32rpx 8rpx}
.shoot-tips text{display:block;color:rgba(255,255,255,.6);font-size:22rpx;line-height:1.7}
.shoot-actions{display:flex;align-items:center;gap:20rpx;padding:20rpx 32rpx calc(40rpx + env(safe-area-inset-bottom))}
.shoot-btn{flex:1;height:88rpx;line-height:88rpx;margin:0;color:#153b2e;background:#ffd766;border-radius:999rpx;font-size:30rpx;font-weight:800}
.shoot-btn::after,.album-btn::after,.back-btn::after{border:0}
.album-btn{flex:1;height:88rpx;line-height:88rpx;margin:0;color:#fff;background:rgba(255,255,255,.14);border-radius:999rpx;font-size:26rpx}
.back-btn{flex:0 0 auto;height:88rpx;line-height:88rpx;margin:0;padding:0 20rpx;color:rgba(255,255,255,.7);background:transparent;font-size:24rpx}
.privacy-mask{position:fixed;top:0;left:0;right:0;bottom:0;z-index:99;display:flex;align-items:center;justify-content:center;background:rgba(0,0,0,.6)}
.privacy-dialog{width:600rpx;padding:40rpx;background:#fff;border-radius:20rpx;box-sizing:border-box}
.privacy-title{display:block;font-size:32rpx;font-weight:800;color:#17231e;margin-bottom:20rpx}
.privacy-text{display:block;font-size:26rpx;line-height:1.6;color:#536259;margin-bottom:30rpx}
.privacy-btns{display:flex;gap:20rpx}
.privacy-refuse,.privacy-agree{flex:1;height:80rpx;line-height:80rpx;margin:0;border-radius:14rpx;font-size:28rpx}
.privacy-refuse::after,.privacy-agree::after{border:0}
.privacy-refuse{color:#617068;background:#eef4f1}
.privacy-agree{color:#fff;background:#176b4d;font-weight:700}
