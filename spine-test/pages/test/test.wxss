.progress-head{display:flex;justify-content:space-between;color:#617068;font-size:26rpx}.progress{height:10rpx;background:#dce6e1;border-radius:8rpx;overflow:hidden;margin:16rpx 0 36rpx}.bar{height:100%;background:#176b4d}.qno{color:#176b4d;font-size:25rpx;font-weight:700}.qtitle{font-size:40rpx;line-height:1.45;font-weight:700;margin:20rpx 0 38rpx}.option{display:flex;align-items:center;min-height:94rpx;padding:20rpx 24rpx;border:2rpx solid #dbe5df;border-radius:14rpx;margin-top:20rpx;box-sizing:border-box}.selected{border-color:#176b4d;background:#edf6f1;color:#10563d;font-weight:600}.radio{display:flex;align-items:center;justify-content:center;width:34rpx;height:34rpx;border:2rpx solid #95a69d;border-radius:50%;margin-right:22rpx}.dot{width:18rpx;height:18rpx;background:#176b4d;border-radius:50%}.actions{display:flex;gap:20rpx;margin-top:30rpx}.action{flex:1;margin:0}.privacy{display:block;text-align:center;color:#89938e;font-size:23rpx;margin-top:28rpx}
.profile-card{margin-top:20rpx}
.profile-title{display:block;font-size:34rpx;font-weight:800}
.profile-sub{display:block;margin:12rpx 0 30rpx;color:#68756e;font-size:25rpx;line-height:1.6}
.pf-group{margin-bottom:30rpx}
.pf-label{display:block;margin-bottom:16rpx;color:#536259;font-size:26rpx;font-weight:700}
.pf-options{display:flex;flex-wrap:wrap;gap:16rpx}
.pf-opt{padding:16rpx 28rpx;color:#617068;background:#eef4f1;border-radius:12rpx;font-size:26rpx;text-align:center}
.pf-opt.on{color:#fff;background:#176b4d;font-weight:700}