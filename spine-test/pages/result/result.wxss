.report{padding:38rpx 34rpx;border-radius:20rpx;background:#eaf5ef;border-top:10rpx solid #348b67}.report.mid{background:#fff6e5;border-color:#d59029}.report.high{background:#fff0ed;border-color:#c6533e}.label{color:#617068;font-size:26rpx}.profile-tag{display:inline-block;margin-top:14rpx;padding:6rpx 16rpx;color:#176b4d;background:#dceee5;border-radius:999rpx;font-size:22rpx;font-weight:700}.profile-note{display:block;margin-top:18rpx;padding:18rpx 20rpx;color:#4f6b5b;background:rgba(255,255,255,.6);border-radius:10rpx;font-size:25rpx;line-height:1.6}.row{display:flex;justify-content:space-between;align-items:center;margin:16rpx 0 22rpx}.level{font-size:52rpx;font-weight:800}.summary{display:block;line-height:1.7}.advice{margin-top:28rpx}.title{font-size:36rpx;font-weight:700}.item{display:flex;gap:20rpx;line-height:1.65;margin-top:24rpx}.num{flex:0 0 44rpx;width:44rpx;height:44rpx;line-height:44rpx;text-align:center;background:#dceee5;color:#176b4d;border-radius:50%}.warning{padding:28rpx;background:#fff7e7;color:#715c3d;border-radius:14rpx;font-size:26rpx;line-height:1.65;margin:28rpx 0}.warning-title{display:block;font-weight:700;margin-bottom:8rpx}.again{margin-top:18rpx}
.dims-card{margin-top:28rpx}
.posture-card{margin-top:28rpx}.posture-type{font-size:32rpx;font-weight:800}.posture-angle{display:block;margin-top:10rpx;color:#176b4d;font-size:26rpx;font-weight:700}.combined{display:block;margin-top:14rpx;padding:16rpx 20rpx;color:#4f6b5b;background:#edf6f1;border-radius:10rpx;font-size:25rpx;line-height:1.6}.dim{margin-top:26rpx}.dim:first-of-type{margin-top:20rpx}.dim-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:12rpx}.dim-name{font-size:28rpx;font-weight:700}.dim-score{color:#617068;font-size:24rpx}.dim-bar{height:12rpx;background:#e8f1ec;border-radius:8rpx;overflow:hidden}.dim-fill{height:100%;border-radius:8rpx}.dim-low{background:#4caf82}.dim-mid{background:#e0a53e}.dim-high{background:#c6533e}.dim-advice{display:block;margin-top:10rpx;color:#617068;font-size:24rpx;line-height:1.6}
.redflag-card{margin-top:28rpx;border-left:6rpx solid #c6533e}.redflag-title{font-size:32rpx;font-weight:800;color:#c0392b}.redflag-sub{display:block;margin:12rpx 0 20rpx;color:#715c3d;font-size:24rpx;line-height:1.6}.redflag-item{display:flex;align-items:center;gap:18rpx;padding:16rpx 0;border-bottom:1rpx solid #f3e8e6;font-size:27rpx}.redflag-item:last-child{border-bottom:0}.check{flex-shrink:0;width:36rpx;height:36rpx;border:2rpx solid #c9a8a2;border-radius:8rpx;display:flex;align-items:center;justify-content:center;color:#fff;font-size:24rpx}.check.on{background:#c6533e;border-color:#c6533e}.redflag-alert{margin-top:20rpx;padding:20rpx;background:#fff0ed;color:#c0392b;border-radius:10rpx;font-size:26rpx;font-weight:700}